{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "#jsx"
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "server.ts",
    "tests/**/*",
    "playwright.config.ts"
  ]
}
